// Reference only: discovery maps for the default .copilot-toolkit/ mount.
// For setup or migration, follow shared init in ../INSTALL.md#build-and-init;
// choose source --build, built package init, or the historical target's own
// setup according to the selected target's capabilities.
//
// Init replaces old toolkit source entries with built entries while preserving
// unrelated consumer entries and deliberate false values; conflicts stop init.
// Do not paste these enabled examples over disabled entries or add them beside
// old toolkit source discovery. These maps show paths, not migration edits.
{
  "chat.agentSkillsLocations": {
    ".copilot-toolkit/build/.github/skills": true
  },
  "chat.agentFilesLocations": {
    ".copilot-toolkit/build/.github/agents": true
  },
  "chat.promptFilesLocations": {
    ".copilot-toolkit/build/.github/prompts": true
  }
}
